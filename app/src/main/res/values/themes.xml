<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AppConsultoria" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorPrimary">#9C27B0</item>
        <item name="colorPrimaryDark">#7b1fa2</item>
        <item name="colorAccent">#c75fd9</item>
    </style>

    <style name="Theme.AppConsultoria.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AppConsultoria.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AppConsultoria.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>